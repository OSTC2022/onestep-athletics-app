# Garmin Connect API (Activity API)
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=

# OAuth callback base URL (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 네이버 지도 · Geocoding (주소 검색)
# https://console.ncloud.com → Application → Maps
# Client ID → NEXT_PUBLIC_NAVER_MAP_CLIENT_ID (브라우저 지도)
# Client Secret → NAVER_MAP_API_KEY (서버 Geocoding 전용, NEXT_PUBLIC_ 금지)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_API_KEY=

# (선택) 네이버 지역 검색 API — 장소명 검색 정확도 향상
# https://developers.naver.com → Application → 검색 → 지역
# Maps Client ID/Secret과 별도 발급
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# USDA FoodData Central — 외부 음식 영양 검색
# 서버 API route(/api/search-food) 전용. NEXT_PUBLIC_ 금지.
# 발급: https://fdc.nal.usda.gov/api-key-signup
# Vercel: Settings → Environment Variables → FOOD_DATA_CENTRAL_API_KEY
FOOD_DATA_CENTRAL_API_KEY=

# Supabase — food_items / external_food_cache (선택)
# 클라이언트: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# 서버: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (NEXT_PUBLIC_ 금지)
# migrations 실행 후: npm run import:foods
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
