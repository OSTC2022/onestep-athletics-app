# ============================================================
# 로컬 개발용 환경변수 예시
# 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채워 넣으세요.
#   cp .env.local.example .env.local
#
# ⚠️ .env.local 은 git에 커밋하지 마세요.
# ⚠️ API KEY에는 NEXT_PUBLIC_ 접두사를 붙이지 마세요 (브라우저 노출 방지).
# ============================================================

# --- 앱 기본 URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 외부 음식 영양 검색 (USDA FoodData Central) ---
# 발급: https://fdc.nal.usda.gov/api-key-signup
# 서버 API route(/api/search-food)에서만 사용됩니다.
# Vercel 배포 시에도 동일한 이름으로 Environment Variables에 등록하세요.
FOOD_DATA_CENTRAL_API_KEY=

# --- Supabase (클라이언트 — 브라우저에 노출 가능) ---
# Dashboard → Project Settings → API → Project URL / anon public key
# NEXT_PUBLIC_SUPABASE_URL 은 SUPABASE_URL 과 동일한 값입니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- Vercel 배포 (추천 메뉴) — 아래 중 하나 ---
# A) 간단: SUPABASE_SERVICE_ROLE_KEY 를 Production env에 추가 후 Redeploy
# B) anon만 사용: NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY 등록 후
#    Supabase SQL Editor에서 supabase/migrations/003_food_items_public_read.sql 실행
#    (점검: npx tsx scripts/apply-public-read-policy.ts)
#
# ⚠️ SUPABASE_SERVICE_ROLE_KEY 에 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
#
# 1) supabase/migrations/*.sql 을 SQL Editor에서 실행
# 2) npm run import:foods:dry-run 으로 CSV 변환 확인
# 3) npm run import:foods 로 공식 CSV import
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- 네이버 지도 (선택) ---
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_API_KEY=

# --- Garmin Connect (선택) ---
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
